<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown by the OS while the process starts (light). The splash art is
         the same mark the Flutter splash draws, so the hand-off is seamless. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Window behind Flutter while the Dart isolate boots. Must be the splash
         art, not colorBackground, or a blank frame flashes between the two. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
